{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "install",
            "type": "process",
            "command": "conan",
            "args": [
                "install",
                ".",
                "-s",
                "&:build_type=RelWithDebInfo",
                "-s",
                "compiler.cppstd=23",
                "-c",
                "tools.cmake.cmaketoolchain:generator=Ninja",
                "--build=missing"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "configure",
            "type": "cmake",
            "command": "configure",
            "preset": "conan-relwithdebinfo",
            "dependsOn": "install",
            "problemMatcher": []
        },
        {
            "label": "build",
            "type": "cmake",
            "command": "build",
            "preset": "conan-relwithdebinfo",
            "dependsOn": "configure",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc",
                "$msCompile"
            ]
        }
    ]
}