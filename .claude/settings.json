{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cmake --preset conan-relwithdebinfo)",
      "Bash(cmake --build --preset conan-relwithdebinfo *)",
      "Bash(ctest --test-dir build/RelWithDebInfo *)",
      "Bash(uv run --project tests pytest *)",
      "Bash(uvx clang-format@22.1.8 *)",
      "Bash(uvx clang-tidy@22.1.8 *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/clang-format.sh"
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": ""
  }
}
